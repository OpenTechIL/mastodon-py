#!/usr/bin/env bash
set -e

cd "$(dirname "$0")/.."

echo "\n== Installing Python dependencies =="
uv sync

echo "\n== Installing JS dependencies =="
npm i -g corepack
yarn install --immutable

echo "\n== Running database migrations =="
uv run alembic upgrade head

echo "\n== Removing old tempfiles =="
rm -rf tmp/cache tmp/pids tmp/sockets

echo "\n== Setup complete =="
